# =====================================================================
# İNGİLİZCE MERKEZ — ORTAM DEĞİŞKENLERİ
#
# Bu dosyayı `.env` olarak kopyalayıp doldurun. `.env` ASLA GitHub'a
# yüklenmez (.gitignore ile engellendi). Netlify'da bu değerleri
# Site configuration → Environment variables altına girin.
#
# VITE_ ile başlayanlar tarayıcıya gömülür; diğerleri sunucuda kalır.
#
# NOT: Katmanlı İngilizce'de kullanıcılar kendi anahtarlarını arayüzden
# de girebilir (sağ üstteki anahtar ikonu). Kullanıcı anahtar girerse o
# kullanılır; girmezse aşağıdaki sunucu anahtarlarına düşülür.
# =====================================================================

# ---------------------------------------------------------------------
# YAPAY ZEKÂ — Katmanlı İngilizce'nin çekirdeği
# Çeviri, sözcük çıkarma, quiz, yazma değerlendirmesi, konuşma
# simülasyonu ve gramer koçu bu anahtarlarla çalışır.
# ---------------------------------------------------------------------

# Google Gemini — ana sağlayıcı
# Alın: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Groq — yedek sağlayıcı. Gemini kotası dolunca otomatik devreye girer.
# Alın: https://console.groq.com/keys
GROQ_API_KEY=

# Sağlayıcı öncelik sırası (virgülle). Varsayılan: gemini,groq
# AI_PROVIDERS=gemini,groq

# ---------------------------------------------------------------------
# YOUTUBE ALTYAZI
# ---------------------------------------------------------------------

# youtube-transcript.io — altyazıları çeker.
# CANLI SİTEDE ŞART: YouTube, Netlify/Lambda gibi veri merkezi IP'lerini
# engellediği için doğrudan çekme bulutta çalışmaz. Bu servis kendi proxy
# havuzunu kullandığından engeli aşar.
# Alın: https://www.youtube-transcript.io/
YOUTUBE_TRANSCRIPT_IO_TOKEN=

# Altyazı kaynağı: auto (varsayılan) | direct | api
#   auto   -> önce doğrudan YouTube, olmazsa youtube-transcript.io
#   direct -> yalnızca doğrudan YouTube (yerel geliştirmede iyi çalışır)
#   api    -> yalnızca youtube-transcript.io
# CAPTION_PROVIDER=auto

# ---------------------------------------------------------------------
# ÇEVİRİ (isteğe bağlı)
# ---------------------------------------------------------------------

# Çeviri motoru: ai (varsayılan) | libre
# TRANSLATE_PROVIDER=ai

# LibreTranslate — yapay zekâ yerine kullanılabilen çeviri servisi.
# Alın: https://portal.libretranslate.com/
LIBRETRANSLATE_API_KEY=
# Kendi sunucunuzu kullanacaksanız:
# LIBRETRANSLATE_URL=https://libretranslate.com/translate

# ---------------------------------------------------------------------
# CİHAZLAR ARASI SENKRONİZASYON (isteğe bağlı, Katmanlı)
# Boş bırakılırsa senkronizasyon kapalı kalır, uygulama yine çalışır.
# Alın: https://supabase.com → proje → Settings → API
# ---------------------------------------------------------------------

SUPABASE_URL=
# DİKKAT: service_role anahtarı tüm yetkilere sahiptir; yalnızca sunucuda
# kalmalı, tarayıcıya asla verilmemeli.
SUPABASE_SERVICE_ROLE_KEY=
# Senkronizasyon kodlarını karıştırmak için rastgele bir dize.
SYNC_SALT=

# ---------------------------------------------------------------------
# OKUMA & KELİME (Lexis Trainer) — tarayıcıya gömülür
# Alın: https://supabase.com → proje → Settings → API
# ---------------------------------------------------------------------

VITE_SUPABASE_URL=https://xxxxx.supabase.co
# anon anahtarı herkese açıktır, service_role ile KARIŞTIRMAYIN.
VITE_SUPABASE_ANON_KEY=eyJhbGci...
